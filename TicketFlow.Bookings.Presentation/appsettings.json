{
  "Jwt": {
    "Issuer": "TicketFlow",
    "Audience": "TicketFlowClient",
    "ExpirationMinutes": 60
  },
  "Booking": {
    "MaxActiveBookingsPerUser": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "Otlp": {
    "ServiceName": "bookings-service",
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
