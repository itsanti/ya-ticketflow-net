{
  "Jwt": {
    "Issuer": "TicketFlow",
    "Audience": "TicketFlowClient",
    "ExpirationMinutes": 60
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-service"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EventTtlSeconds": 60,
    "TopEventsTtlSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
